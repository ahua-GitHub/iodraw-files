{"root":{"data":{"id":"djlbxrpryr40","created":1782715597958,"text":"职业生涯","expandState":"expand"},"children":[{"data":{"id":"dlkprgixnpk0","created":1789965355877,"text":"智驾测试","expandState":"expand"},"children":[{"data":{"id":"dlkoqbw0er40","created":1789962446311,"text":"软件平台测试","expandState":"expand"},"children":[{"data":{"id":"dlkponaqp2w0","created":1789965135527,"text":"性能稳定性","expandState":"expand"},"children":[{"data":{"id":"dlkqelto8y80","created":1789967169786,"text":"1）性能&稳定性红线","expandState":"expand","note":"简单业务场基础指标检查"},"children":[{"data":{"id":"dm0x58kzao80","created":1791611142761,"text":"系统资源","expandState":"expand"},"children":[{"data":{"id":"dlkqjjnjpaw0","created":1789967556883,"text":"io","expandState":"collapse"},"children":[{"data":{"id":"dlkqjlm4p6o0","created":1789967561151,"text":"读写请求数量"},"children":[]},{"data":{"id":"dlkqlmlkh3c0","created":1789967720022,"text":"读写字节数"},"children":[]},{"data":{"id":"dlkqls88b600","created":1789967732276,"text":"平均队列长度","note":"正在等待处理的 I/O 请求数量。队列越长，说明存储设备来不及处理，可能积压"},"children":[]},{"data":{"id":"dlkqmftr2w00","created":1789967783644,"text":"平均读写的块大小","note":"如果这个值很大，说明是以大文件顺序读写为主；如果很小，则说明是小文件随机读写"},"children":[]},{"data":{"id":"dlkqlwrrf080","created":1789967742164,"text":"平均响应时间","note":"包括了 I/O 队列等待时间和设备实际处理时间。如果 await 远大于设备正常的响应时间，说明 I/O 压力已经过载"},"children":[]},{"data":{"id":"dlkqm0gpydk0","created":1789967750204,"text":"设备利用率","note":"一秒钟内有百分之多少的时间该设备在处理 I/O 请求。\n\n对于现代可以并行处理的 NVMe SSD 或 RAID 阵列，即使 %util 达到 100%，也不一定代表存储带宽被吃满，它只代表设备一直有活干。真正的瓶颈更需要参考 await"},"children":[]}]},{"data":{"id":"dlkqf8l043c0","created":1789967219328,"text":"内存","note":"1、系统整体内存占用\n2、各业务节点内存占用\n\ntop工具\npidstat工具","expandState":"collapse"},"children":[{"data":{"id":"dlkqj0sis7k0","created":1789967515825,"text":"系统内存占用"},"children":[]},{"data":{"id":"dlkqj60bvao0","created":1789967527181,"text":"各进程内存占用"},"children":[]},{"data":{"id":"dlkqtwdg1yg0","created":1789968368212,"text":"内存增长曲线"},"children":[]},{"data":{"id":"dlkqy4x76480","created":1789968700277,"text":"线程占用"},"children":[]},{"data":{"id":"dlkqy89ki000","created":1789968707556,"text":"线程增长曲线"},"children":[]}]},{"data":{"id":"dlkqhjmr2740","created":1789967400107,"text":"cpu","expandState":"collapse","note":"perf工具\ntopgong'j"},"children":[{"data":{"id":"dlkqhxqyjvc0","created":1789967430836,"text":"各核使用率"},"children":[]},{"data":{"id":"dlkqi5hbo9k0","created":1789967447668,"text":"各进程使用率"},"children":[]},{"data":{"id":"dlkqu179maw0","created":1789968378722,"text":"cpu增长曲线"},"children":[]},{"data":{"id":"dlkqyfxxou80","created":1789968724267,"text":"线程使用率"},"children":[]},{"data":{"id":"dlkqykwsvnk0","created":1789968735082,"text":"线程增长曲线"},"children":[]}]},{"data":{"id":"dlkrhlcmjw80","created":1789970224958,"text":"gpu","expandState":"collapse"},"children":[{"data":{"id":"dlkrhogvglc0","created":1789970231745,"text":"整体gpu占用"},"children":[]},{"data":{"id":"dlkrhvao5y00","created":1789970246607,"text":"业务进程gpu占用"},"children":[]},{"data":{"id":"dlkrhxq55so0","created":1789970251897,"text":"gpu增长曲线"},"children":[]}]},{"data":{"id":"dm0x9uheme80","created":1791611503891,"text":"带宽"},"children":[]},{"data":{"id":"dm0x9wnt3o80","created":1791611508631,"text":"时延"},"children":[]}]},{"data":{"id":"dm0x5dkx90o0","created":1791611153641,"text":"业务状态"},"children":[{"data":{"id":"dm0x5lya2z40","created":1791611171863,"text":"coredump"},"children":[]},{"data":{"id":"dm0x5ovvq7c0","created":1791611178249,"text":"延迟/帧率下降"},"children":[]},{"data":{"id":"dm0x8h0qj2w0","created":1791611396220,"text":"感知/规控 输出"},"children":[]}]}]},{"data":{"id":"dlkrbcpopn40","created":1789969735972,"text":"2）业务场景模型","note":"根据交付范围设计业务场景模型，补充数据，验证各种场景下的系统性能稳定性资源占用情况","expandState":"expand"},"children":[{"data":{"id":"dm0xa6kv50o0","created":1791611530221,"text":"智驾头部场景"},"children":[{"data":{"id":"dlkrfs017m80","created":1789970082706,"text":"行车"},"children":[]},{"data":{"id":"dlkrft3diw80","created":1789970085084,"text":"泊车"},"children":[]},{"data":{"id":"dlkrftxgz9c0","created":1789970086904,"text":"adas"},"children":[]}]},{"data":{"id":"dm0xaftvih40","created":1791611550357,"text":"环境要素"},"children":[{"data":{"id":"dllpj12v7q00","created":1790066255297,"text":"光线","expandState":"collapse"},"children":[{"data":{"id":"dllq5f3me0g0","created":1790068009829,"text":"明亮"},"children":[]},{"data":{"id":"dllq5g7pjpc0","created":1790068012253,"text":"昏暗"},"children":[]},{"data":{"id":"dllq5jvm1rs0","created":1790068020229,"text":"强光"},"children":[]},{"data":{"id":"dllq5lr9k5s0","created":1790068024320,"text":"炫光"},"children":[]}]},{"data":{"id":"dllpj3bgur40","created":1790066260171,"text":"天气","expandState":"collapse"},"children":[{"data":{"id":"dllq48h7hjk0","created":1790067917049,"text":"晴天"},"children":[]},{"data":{"id":"dllq49pt9ls0","created":1790067919746,"text":"雨天"},"children":[]},{"data":{"id":"dllq4amom880","created":1790067921734,"text":"雾天"},"children":[]},{"data":{"id":"dllq4ehyqo00","created":1790067930156,"text":"傍晚"},"children":[]}]},{"data":{"id":"dllpj6hd8k80","created":1790066267058,"text":"脏污","expandState":"collapse"},"children":[{"data":{"id":"dllq4n2ilj40","created":1790067948813,"text":"雨雪"},"children":[]},{"data":{"id":"dllq4upmy2o0","created":1790067965448,"text":"异物"},"children":[]}]},{"data":{"id":"dllq4i1j94w0","created":1790067937869,"text":"地上地下","expandState":"collapse"},"children":[{"data":{"id":"dllq5uw2teo0","created":1790068044202,"text":"地上"},"children":[]},{"data":{"id":"dllq5x6shog0","created":1790068049203,"text":"地下"},"children":[]},{"data":{"id":"dllq5xzl12w0","created":1790068050944,"text":"坡道"},"children":[]}]}]},{"data":{"id":"dm0xbxgba5c0","created":1791611667083,"text":"负载压测"},"children":[{"data":{"id":"dlkrdhsdskg0","created":1789969903747,"text":"高低温"},"children":[]},{"data":{"id":"dlkrdj04aq00","created":1789969906391,"text":"长时间"},"children":[]},{"data":{"id":"dlkrduaaasg0","created":1789969930951,"text":"高负载","note":"fio工具模拟文件读写","expandState":"collapse"},"children":[{"data":{"id":"dlkri588bm80","created":1789970268228,"text":"高io"},"children":[]},{"data":{"id":"dlkriakepy80","created":1789970279848,"text":"高cpu"},"children":[]},{"data":{"id":"dlkrif69yls0","created":1789970289877,"text":"高内存"},"children":[]},{"data":{"id":"dlkrigmaygo0","created":1789970293023,"text":"高gpu"},"children":[]}]}]},{"data":{"id":"dlkqg6d934w0","created":1789967292870,"text":"4）极端工况","expandState":"expand"},"children":[{"data":{"id":"dm07bgn28kg0","created":1791538281629,"text":"长尾场景","layout_right_offset":{"x":-171.99999487400078,"y":21.999999344348907}},"children":[]}]},{"data":{"id":"dlkrh0oxj940","created":1789970179989,"text":"故障注入","expandState":"expand"},"children":[{"data":{"id":"dlkrh3jabww0","created":1789970186179,"text":"传感器异常"},"children":[]},{"data":{"id":"dlkrhdb81xs0","created":1789970207459,"text":"电压不稳"},"children":[]},{"data":{"id":"dlkrisv9k3s0","created":1789970319687,"text":"网络中断"},"children":[]},{"data":{"id":"dlkriv33fzk0","created":1789970324514,"text":"topic 异常字段","note":"none\n空\n超出字段设计范围"},"children":[]},{"data":{"id":"dlkrjte0m8g0","created":1789970399185,"text":"定位中断"},"children":[]},{"data":{"id":"dlkrfiao7rk0","created":1789970061581,"text":"异常复位","expandState":"expand"},"children":[{"data":{"id":"dlkrkj6upf40","created":1789970455348,"text":"断电重启"},"children":[]},{"data":{"id":"dlkrko7affs0","created":1789970466258,"text":"反复断电重启"},"children":[]},{"data":{"id":"dlkrks5t9eo0","created":1789970474876,"text":"模拟进程oom"},"children":[]}]}]}]},{"data":{"id":"dlkrlgcv07k0","created":1789970527545,"text":"5）工具补充","expandState":"collapse"},"children":[{"data":{"id":"dlkrm04d0s00","created":1789970570567,"text":"ASAN","note":"用于检测内存相关问题，但对系统资源消耗太大 cpu和内存都会翻倍增长\n1、Heap/Stack/Global buffer overflow（内存越界/溢出）：数组越界、指针乱指\n2、Memory Leaks（内存泄漏）：程序退出时，内置的 LeakSanitizer (LSan) 会自动检查是否有未释放的内存\n3、Use after free (UAF / 悬空指针)：内存释放后仍然去读写\n4、Use after return：函数返回后，却去访问该函数内部的局部变量（栈内存\n"},"children":[]},{"data":{"id":"dlkro57qsdk0","created":1789970738383,"text":"TSAN","note":"TSan 专门用于检测多线程并发程序中的数据竞争和死锁风险，内存cpu占用巨大，5-10倍左右\n\n1、Data Races（数据竞争）：多线程无锁读写同一变量\n2、Deadlocks（死锁）：由于加锁顺序不一致（如线程1锁A拿B，线程2锁B拿A）导致的潜在死锁\n3、销毁已被锁定的锁：锁还在用，却被销毁了"},"children":[]},{"data":{"id":"dlkrqyd67080","created":1789970958566,"text":"业务通信时延","note":"通过业务埋点，记录每个节点收到 DDS 数据 -> 触发回调 -> 算法执行 -> 再次发布 整个生命周期中处理时延\n\n可以发现诸如算法模型迭代、后处理逻辑变更、业务增删等带来的处理耗时"},"children":[]}]},{"data":{"id":"dlloujnz9sw0","created":1790064336652,"text":"6）平台功能稳定性","expandState":"collapse"},"children":[{"data":{"id":"dlkqlcbtyso0","created":1789967697666,"text":"网络通信","expandState":"collapse"},"children":[{"data":{"id":"dlkqleosfgg0","created":1789967702803,"text":"网卡的带宽","note":"网络链路在单位时间内能够传输的最大数据量（理论上限，通常单位为 Mbps 或 Gbps）"},"children":[]},{"data":{"id":"dlkqolkbrdk0","created":1789967952863,"text":"网卡吞吐量","note":"在没有丢包和错误的前提下，数据实际通过网络链路的真实速率"},"children":[]},{"data":{"id":"dlkqp9wg03c0","created":1789968005838,"text":"丢包率","note":"定义：在传输过程中丢失的数据包占总发送数据包的百分比\n\n影响：网络拥堵或信号干扰会导致丢包。高丢包率会引发TCP协议频繁重传，导致网速断崖式下跌；在UDP应用（如视频通话）中则表现为画面卡顿、花屏或声音断续"},"children":[]},{"data":{"id":"dlkqqojdca80","created":1789968116064,"text":"延迟","note":"1、平均延迟\n2、单次延迟\n\n一般不超过200ms"},"children":[]}]},{"data":{"id":"dlkqrlyl8q80","created":1789968188818,"text":"进程管理","expandState":"collapse"},"children":[{"data":{"id":"dlkqrv03e740","created":1789968208500,"text":"进程启动","note":"版本迭代验证进程启动以及启动顺序"},"children":[]},{"data":{"id":"dlkqs491kgo0","created":1789968228632,"text":"异常恢复","note":"通过kill -9 等指令模拟进程异常退出，验证故障恢复能力"},"children":[]},{"data":{"id":"dlkqzwdc7q80","created":1789968838391,"text":"coredump","note":"进程异常崩溃监控"},"children":[]},{"data":{"id":"dlkr4fh1ri80","created":1789969193430,"text":"启动时长"},"children":[]},{"data":{"id":"dlkr4k6wx0o0","created":1789969203702,"text":"启动时序","note":"业务节点可能存在依赖关系，启动时序异常会导致业务崩溃"},"children":[]}]},{"data":{"id":"dlkr1nfults0","created":1789968975680,"text":"状态机","expandState":"collapse"},"children":[{"data":{"id":"dlkr20bndo00","created":1789969003724,"text":"状态机切换","note":"验证是否切换成功"},"children":[]},{"data":{"id":"dlkr2a59zm00","created":1789969025106,"text":"切换时长","note":"验证状态切换是否超过限定时长"},"children":[]},{"data":{"id":"dlkr2d4l5qw0","created":1789969031595,"text":"各状态下的业务运行状态","note":"1、切换前后对应状态下的业务运行状态\n2、切换后系统资源占用"},"children":[]}]},{"data":{"id":"dll453a32s80","created":1790005919681,"text":"磁盘分区&权限","note":"业务交付后为了安全会对磁盘进行分区和权限控制\n\n需要针对指定的磁盘、文件夹的读写权限 用户组权限进行验证\t","expandState":"collapse"},"children":[{"data":{"id":"dll46obdjog0","created":1790006043836,"text":"读写权限"},"children":[]},{"data":{"id":"dll46quq0140","created":1790006049359,"text":"用户组权限"},"children":[]}]},{"data":{"id":"dlkqxwd3gog0","created":1789968681648,"text":"日志落盘","expandState":"collapse"},"children":[{"data":{"id":"dlkr0jnsi5k0","created":1789968889090,"text":"日志大小"},"children":[]},{"data":{"id":"dlkr0m31kt40","created":1789968894364,"text":"日志量"},"children":[]},{"data":{"id":"dlkr0qxhkkg0","created":1789968904912,"text":"日志等级"},"children":[]}]},{"data":{"id":"dlkr764oogg0","created":1789969408184,"text":"ROS2 & DDS","note":"ros2多平台多节点通信、数据传输\nDDS发布订阅的通信标砖，负责底层通信，通过不同的qos策略保证通信质量","expandState":"collapse"},"children":[{"data":{"id":"dlkr7atrizc0","created":1789969418408,"text":"node、topic数量 名称"},"children":[]},{"data":{"id":"dlkra6p0ui80","created":1789969644507,"text":"topic hz"},"children":[]},{"data":{"id":"dlkravpmpls0","created":1789969698963,"text":"qos策略"},"children":[]}]}]}]},{"data":{"id":"dlkpovt7pa00","created":1789965154058,"text":"软件功能","expandState":"collapse"},"children":[{"data":{"id":"dlkps13gw4w0","created":1789965400654,"text":"ota","expandState":"collapse"},"children":[{"data":{"id":"dll47caliqw0","created":1790006096031,"text":"验证内容","expandState":"collapse"},"children":[{"data":{"id":"dll47dushoo0","created":1790006099429,"text":"云端","expandState":"collapse"},"children":[{"data":{"id":"dll481rsjrk0","created":1790006151491,"text":"下发"},"children":[]},{"data":{"id":"dll4847dab40","created":1790006156786,"text":"终止"},"children":[]},