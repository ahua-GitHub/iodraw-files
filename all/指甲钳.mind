text":"超声波雷达工作原理"},"children":[]},{"data":{"id":"djlc9fos7xs0","created":1782716512147,"text":"毫米波雷达工作原理"},"children":[]},{"data":{"id":"djlc9r41klk0","created":1782716537014,"text":"激光雷达工作原理"},"children":[]},{"data":{"id":"djlca5tuwy00","created":1782716569050,"text":"多传感器同步"},"children":[]}]},{"data":{"id":"djlc78s6xns0","created":1782716340387,"text":"测试环境与仿真","expandState":"collapse"},"children":[{"data":{"id":"djlcc5dn7x40","created":1782716724798,"text":"仿真平台、实车、台架环境搭建","expandState":"collapse"},"children":[{"data":{"id":"djmezs88vnk0","created":1782825779090,"text":"车端部署"},"children":[]},{"data":{"id":"djmezxexveo0","created":1782825790379,"text":"云端部署"},"children":[]}]},{"data":{"id":"djlcc9y1n200","created":1782716734739,"text":"数据采集与标注","expandState":"collapse"},"children":[{"data":{"id":"dlll6raplqw0","created":1790054009194,"text":"鱼眼图像标注"},"children":[]},{"data":{"id":"dlll6yd7po80","created":1790054024583,"text":"激光bev标注"},"children":[]},{"data":{"id":"dlll71kni800","created":1790054031563,"text":"4d标注"},"children":[]}]},{"data":{"id":"djlccmnzae00","created":1782716762428,"text":"回灌工具链","expandState":"collapse"},"children":[{"data":{"id":"djmf02pg7kg0","created":1782825801898,"text":"环境初始化"},"children":[]},{"data":{"id":"djmf0p9nu8o0","created":1782825851009,"text":"数据初始化"},"children":[]},{"data":{"id":"djmf89jfxh40","created":1782826443685,"text":"个性化需求","layout_right_offset":{"x":4.999999776482582,"y":-11.249999497085867}},"children":[]},{"data":{"id":"djmf0tdkrmg0","created":1782825859953,"text":"业务运行","layout_right_offset":{"x":4.999999776482582,"y":-11.249999497085867}},"children":[]},{"data":{"id":"djmf9w0tq2o0","created":1782826570990,"text":"结果收集","layout_right_offset":{"x":4.999999776482582,"y":-11.249999497085867}},"children":[]}]}]},{"data":{"id":"djlced6ma540","created":1782716898516,"text":"泊车模型&后处理","expandState":"expand"},"children":[{"data":{"id":"djlc5pysac00","created":1782716221063,"text":"模型基础概念","expandState":"expand"},"children":[{"data":{"id":"djlcahghz8g0","created":1782716594364,"text":"计算机视觉原理","note":"通过传感器获取视觉信号并转换为数字矩阵，再利用深度学习与机器学习算法提取特征，从而实现从像素解析到高级语义的理解","expandState":"collapse"},"children":[{"data":{"id":"djld3fm4x080","created":1782718862912,"text":"核心工作流程","expandState":"collapse"},"children":[{"data":{"id":"djld3k4x9qw0","created":1782718872755,"text":"图像采集","note":"利用相机等传感器获取原始视觉信号（像素），并进行去噪、色彩转换和对比度增强等操作"},"children":[]},{"data":{"id":"djld3nhppp40","created":1782718880059,"text":"特征提取","note":"算法（如卷积神经网络）从图像中提取边缘、纹理、形状等局部特征，再逐层抽象为全局特征"},"children":[]},{"data":{"id":"djld3py6qq80","created":1782718885408,"text":"模型推理与决策","note":"借助深度学习模型对提取的特征进行分类、定位、分割或描述，完成预定任务"},"children":[]}]},{"data":{"id":"djld4qo0daw0","created":1782718965334,"text":"基础任务"},"children":[{"data":{"id":"djld4vd1vz40","created":1782718975555,"text":"图像分类（Image Classification）","note":"识别图像中主要物体的类别（例如识别图像是“猫”还是“狗”）"},"children":[]},{"data":{"id":"djld53ngzlk0","created":1782718993599,"text":"目标检测（Object Detection）","note":"识别图像中的特定目标，并用边界框（Bounding Box）标出其精确位置（如自动驾驶中的行人识别）"},"children":[]},{"data":{"id":"djld57crcv40","created":1782719001659,"text":"图像分割（Image Segmentation）","note":"将图像细分为多个区域或像素类别，提取目标轮廓（如医学图像中的病灶勾勒）"},"children":[]},{"data":{"id":"djld5ap8nug0","created":1782719008944,"text":"目标跟踪（Object Tracking）","note":"在视频序列中持续追踪特定目标，记录其运动轨迹（如智能安防中的人员追踪）"},"children":[]},{"data":{"id":"djld5f3t44w0","created":1782719018532,"text":"三维重建（3D Reconstruction）","note":"通过多视角图像或深度信息，恢复现实场景的三维立体结构"},"children":[]}]},{"data":{"id":"djld5kdx2pk0","created":1782719030027,"text":"主流技术"},"children":[{"data":{"id":"djld5pt6qgw0","created":1782719041834,"text":"卷积神经网络（CNN）","note":"计算机视觉的基石，通过卷积层模拟人类视觉的局部感知机制，擅长处理网格状的图像数据"},"children":[]},{"data":{"id":"djld5xrx8ts0","created":1782719059172,"text":"视觉Transformer（ViT）","note":"基于自注意力机制，能够捕捉图像全局上下文信息，广泛应用于最新的前沿大模型中"},"children":[]},{"data":{"id":"djld61l31z40","created":1782719067466,"text":"生成式视觉","note":"扩散模型（Diffusion Models）和生成对抗网络（GAN），能够根据文本或图像提示生成高质量的新图像"},"children":[]}]}]},{"data":{"id":"djlcak2rqjk0","created":1782716600064,"text":"传感器融合概念"},"children":[]},{"data":{"id":"djlcao9xy3c0","created":1782716609205,"text":"目标检测与跟踪算法"},"children":[]},{"data":{"id":"djlcb0clsy80","created":1782716635487,"text":"SLAM （同步定位与建图"},"children":[]}]},{"data":{"id":"djlcf2910o80","created":1782716953081,"text":"模型细分类","expandState":"expand"},"children":[{"data":{"id":"djmfcngwhmo0","created":1782826787463,"text":"3D occ（Occupancy Network）障碍物","note":"通过将三维空间切分成数以万计的微小方块（体素 Voxel），来预测每个方块是否被物体占用","expandState":"expand"},"children":[{"data":{"id":"djmfjady29c0","created":1782827307536,"text":"模型特点","expandState":"collapse"},"children":[{"data":{"id":"djmfvzyi3m00","created":1782828303569,"text":"无视类型","note":"轻语义，重几何，检测该3D空间内是否有被占据；传统的3d识别需要先识别类型再输出3d框，容易漏检和误检"},"children":[]},{"data":{"id":"djmfyakitsw0","created":1782828483396,"text":"精细表达","note":"传统3D框一般多为标准长方体，对于不规则物体极其容易失真，occ将空间切割为3D网格，可以贴合描绘出任何异形、非刚体、可变形物体的细腻几何轮廓"},"children":[]},{"data":{"id":"djmg1338j0o0","created":1782828702206,"text":"三维感知","note":"传统BEV将3D压成2D的实现方式不同，occ具有高度信息，对限高杆等有高度的物体可以输出可通行信息"},"children":[]},{"data":{"id":"djmg445i04g0","created":1782828939612,"text":"计算量大","note":"从2维提升到3维对芯片算力和内存带宽消耗巨大，目前主流的做法是稀疏化"},"children":[]}]},{"data":{"id":"djmfj2hhtnc0","created":1782827290336,"text":"测试设计","expandState":"expand"},"children":[{"data":{"id":"djmfr91h3tc0","created":1782827931518,"text":"场景设计","note":"依据模型应用场景和特性设计测试的场景，采集对应的场景数据","expandState":"collapse"},"children":[{"data":{"id":"dm01k2wvprs0","created":1791522030365,"text":"业务场景全覆盖","expandState":"collapse"},"children":[{"data":{"id":"dm02bfihje00","created":1791524173626,"text":"白名单障碍物"},"children":[]},{"data":{"id":"dm06t2lmd6w0","created":1791536840511,"text":"通用场景障碍物"},"children":[]}]},{"data":{"id":"dm01kf8o6w80","created":1791522057200,"text":"耦合环境要素"},"children":[]},{"data":{"id":"dm010t7aegg0","created":1791520520308,"text":"误检场景构建","note":"解决误检，核心是\n1. 提升视觉编码器的分辨率和分类精度2. 喂更多相似视觉数据","expandState":"collapse"},"children":[{"data":{"id":"dm02bnsjkjk0","created":1791524191648,"text":"可行驶区域"},"children":[]},{"data":{"id":"dm02bvygp400","created":1791524209420,"text":"限高区域"},"children":[]},{"data":{"id":"dm02c4p30kg0","created":1791524228444,"text":"坡道"},"children":[]},{"data":{"id":"dm02c8fbce80","created":1791524236560,"text":"闸机"},"children":[]},{"data":{"id":"dm02cistyqo0","created":1791524259146,"text":"弯道"},"children":[]}]},{"data":{"id":"dm01lapa9hs0","created":1791522125684,"text":"问题场景集"},"children":[]},{"data":{"id":"dm01lnq7gmo0","created":1791522154038,"text":"长尾场景集构建","expandState":"collapse"},"children":[{"data":{"id":"dm02evtdhhk0","created":1791524444205,"text":"低矮路沿"},"children":[]},{"data":{"id":"dm02exiakbk0","created":1791524447888,"text":"闸机口"},"children":[]},{"data":{"id":"dm02f093zvk0","created":1791524453864,"text":"坡道"},"children":[]},{"data":{"id":"dm02f29n1wg0","created":1791524458249,"text":"限高区域"},"children":[]},{"data":{"id":"dm02f6yvvhs0","created":1791524468483,"text":"狭窄路口"},"children":[]},{"data":{"id":"dm02fcig3080","created":1791524480550,"text":"光线昏暗"},"children":[]}]}]},{"data":{"id":"dm030x5ofps0","created":1791526171137,"text":"指标设计","expandState":"collapse"},"children":[{"data":{"id":"dm0291rnzaw0","created":1791523986977,"text":"准确率","note":"判断检测的结果对不对的比例\n\n正确的正例(TP)/模型检出的总数（TP+FP）"},"children":[]},{"data":{"id":"dm0294y62ug0","created":1791523993901,"text":"召回率","note":"检测目标有没有被漏掉\n\n正确的正例（TP）/物理存在的总数（TP+FN）"},"children":[]},{"data":{"id":"dm03156mohk0","created":1791526188609,"text":"检出率","note":"检测目标有没有被漏掉\n\n正确的正例（TP）/物理存在的总数（TP+FN）\n\n分母也有可能改为真值的个数"},"children":[]},{"data":{"id":"dm02961577s0","created":1791523996258,"text":"误检率","note":"实际不存在的目标被检出的比例\n\n错误的检出帧数/总帧数"},"children":[]},{"data":{"id":"dm031kj3oo00","created":1791526222015,"text":"检出精度","note":"计算匹配上的目标与真值最近点或者中心点的距离"},"children":[]}]}]},{"data":{"id":"djmfjhw20y80","created":1782827323868,"text":"测试实现","expandState":"collapse"},"children":[{"data":{"id":"djmfsw3fa5c0","created":1782828060066,"text":"数据采集"},"children":[]},{"data":{"id":"djmft0m55200","created":1782828069905,"text":"数据标注","expandState":"collapse"},"children":[{"data":{"id":"djn5y30l1s00","created":1782901815810,"text":"4D标注","expandState":"collapse","note":"1、时空对齐：把一整条路测片段（如 30 秒的视频和点云）拼起来，利用高精定位（SLAM）和组合导航将所有帧的点云“缝合”成一个全局连续的 4D 静态世界大点云地图\n2、动态剔除：算法通过多帧前后追踪（Multi-frame Tracking），自动把路上行驶的背景车等动态物体的轨迹剥离出来。\n3、大模型预标注：用多视角大模型（如 NeRF、3DGS、自动标注大模型）直接将空间切碎为 4D 占用体素网格（Voxel Grid），或者自动生成连续的 3D 轨迹流。\n4、人工回放修剪：标注员不再一帧一帧画框，而是直接在时间轴上微调物体的轨迹曲线或修正立体空间的网格标签（占用/空闲"},"children":[{"data":{"id":"djn6qs51auw0","created":1782904064696,"text":"优点","layout_right_offset":{"x":-8.333332753843706,"y":36.666664116912216}},"children":[{"data":{"id":"djn6qtm8mn40","created":1782904067913,"text":"有时序信息","note":"不是单帧信息而是多帧缝合，多帧的点云根据时序信息融合在一起\n1、能解决短暂遮挡场景\n2、能解决不规则的异形物体"},"children":[]},{"data":{"id":"djn6tdlf4bc0","created":1782904268127,"text":"精度更高","note":"抛弃了原有3D标注的方框概念，4D是将其切割成细小方块，为方块标注占据状态，对于异形物体的形状表达更精细"},"children":[]}]},{"data":{"id":"djn705owunc0","created":1782904799473,"text":"缺点","layout_right_offset":{"x":-1.6666665507686957,"y":23.333331710762423}},"children":[{"data":{"id":"djn70c8kluw0","created":1782904813723,"text":"标注成本高"},"children":[]},{"data":{"id":"djn70erq5nk0","created":1782904819234,"text":"标注工具要求高"},"children":[]}]}]},{"data":{"id":"djn5wkitf6w0","created":1782901697190,"text":"鱼眼图像标注","note":"在图像上拉出边界线，然后通过内参矩阵进行坐标转换","expandState":"collapse"},"children":[{"data":{"id":"djn622bxcig0","created":1782902127776,"text":"优点"},"children":[{"data":{"id":"djn627py3so0","created":1782902139508,"text":"近距离覆盖范围广（0-6m"},"children":[]},{"data":{"id":"djn62q0dxpk0","created":1782902179321,"text":"语义丰富，可标注类型多"},"children":[]}]},{"data":{"id":"djn624j7rc00","created":1782902132570,"text":"缺点"},"children":[{"data":{"id":"djn62o8itmo0","created":1782902175459,"text":"图像远距离的像素差，会产生指数级的精度误差（大于15m"},"children":[]},{"data":{"id":"djn639fwsdk0","created":1782902221619,"text":"只有2d信息，3D障碍物只能进行标注边缘，精度差"},"children":[]},{"data":{"id":"djn64e3n5nk0","created":1782902310125,"text":"图像边缘畸变大，精度差"},"children":[]},{"data":{"id":"djn6mmj33ds0","created":1782903739028,"text":"图像容易受光线影响"},"children":[]}]}]},{"data":{"id":"djn5y80eyqo0","created":1782901826684,"text":"激光3D标注","note":"标注工具加载 3D 点云图，标注员通过多视角（Top-View 鸟瞰图、Front-View 前视图、3D 渲染图）联动，用鼠标选中点云簇，为其包裹一个 3D 长方体框（Bounding Box，含长宽高、中心点坐标、航向角 Roll/Pitch/Yaw）\t","expandState":"collapse"},"children":[{"data":{"id":"djn6hikgw940","created":1782903338584,"text":"优点"},"children":[{"data":{"id":"djn6lj1hcio0","created":1782903653069,"text":"激光点云的精度更高"},"children":[]},{"data":{"id":"djn6lyrx2i00","created":1782903687319,"text":"激光不受光线变化影响"},"children":[]}]},{"data":{"id":"djn6hldvfd40","created":1782903344715,"text":"缺点"},"children":[{"data":{"id":"djn6my30two0","created":1782903764178,"text":"语义信息匮乏，无法区分类型以及细微的轮廓特征"},"children":[]},{"data":{"id":"djn6nui0xjc0","created":1782903834742,"text":"随着距离增加，点云会变得稀疏，远距离物体难以判断物理边界"},"children":[]}]}]}]},{"data":{"id":"djmft6t9wx40","created":1782828083397,"text":"真值处理","expandState":"collapse"},"children":[{"data":{"id":"djn8unwrd6o0","created":1782910011165,"text":"真值下载"},"children":[]},{"data":{"id":"djna13pk5g80","created":1782913336853,"text":"真值过滤","note":"因为真值标注结果、范围可能较大，全部加载浪费资源，按需加载使用的真值","expandState":"collapse"},"children":[{"data":{"id":"djnatadqc0o0","created":1782915545571,"text":"真值插值（上采样","note":"为什么：\n\t对于点数少但是很长的障碍物  遮挡计算和位置计算更精准\n\n怎么做：\n\t需要对目标障碍物点进行插值 做一个稠密化操作 "},"children":[]},{"data":{"id":"djnbhll9w8o0","created":1782917450712,"text":"FOV过滤","expandState":"collapse","note":"为什么：\n\t判断障碍物是否在可视范围内，过滤不在可视范围内的障碍物\n    \n怎么做：\n\t通过判断障碍物的几何形状与传感器的FOV是否相交"},"children":[{"data":{"id":"djnadu88ugo0","created":1782914334949,"text":"获取传感器外参","note":"通过配置文件读取读取相机fov角度、朝向、可视距离等"},"children":[]},{"data":{"id":"djnae8xypdc0","created":1782914366979,"text":"极坐标转换生成多边形区域","note":"利用三角函数将极坐标转换成直角坐标\n\n直角坐标系 (X, Y)：\n\t通过横坐标和纵坐标定位。\n\n极坐标系 (R, theta)：\n\t通过距离圆心的半径(R)和与正 X 轴的夹角(theta)定位\n\n余弦函数 (cos)：\n\t邻边=斜边*cos(theta)\n\n正弦函数 (sin)：\n\t对边=斜边*sin(theta)\n    \n斜边就是圆的半径 (R)，那么这个点的直角坐标就是\n\tx=R*con(theta)\n    y=R*sin(theta)"},"children":[]},{"data":{"id":"djnbicy6eso0","created":1782917510265,"text":"FOV之外过滤","note":"1、通过障碍物点与FOV区域是否有交集进行粗筛\n2、计算障碍物与多边形的IOU比例，比例过小说明大部分在可视范围外"},"children":[]}]},{"data":{"id":"dk3yl8o3hi00","created":1784607580876,"text":"边缘过滤","note":"为什么：\n\t有些障碍物部分在fov中，处于fov中物体比例太小时认为该物体其实是看不见的\n\n怎么做：\n\t计算障碍物点落在FOV中的比例，过滤比例低的障碍物点"},"children":[]},{"data":{"id":"djnbiqh7v0g0","created":1782917539715,"text":"遮挡过滤","note":"为什么：\n\t有的障碍物之间会互相遮挡，或者柱子可能标注了好几面，但是后面的柱子车辆根本不可视，需要过滤\n    \n怎么做：\n\t通过射线投射法，判断每个障碍物点是否被其他物体遮挡，遮挡比例高的障碍物认为不可见，过滤掉","expandState":"collapse"},"children":[{"data":{"id":"djnbygw2pnc0","created":1782918772672,"text":"目标遮挡过滤","note":"1、从传感器中心引出与目标障碍物点连接的线段\n2、判断线段是否与其他障碍物相交\n3、相交则证明目标障碍物该点被遮挡","expandState":"expand"},"children":[]},{"data":{"id":"djnc47wkl0g0","created":1782919223296,"text":"自身遮挡过滤","note":"1、障碍物点与传感器中心的连线与自身交集点大于1则该点被自身遮挡\n2、顺序遍历遮挡和未遮挡点\n3、通过遮挡和非遮挡的状态切换将遮挡点和未遮挡点进行分类\n4、设置遮挡的长度或者面积限制（算法理应有小遮挡的是识别能力）"},"children":[]},{"data":{"id":"djnbw3bmmkw0","created":1782918586409,"text":"白名单保留","note":"某些类型如墙、柱子 因为高度较高 一般不会存在遮挡情况 需要额外保留"},"children":[]}]},{"data":{"id":"djnbhoxw26g0","created":1782917458005,"text":"类型过滤","note":"为什么:\n\t标注类型过多，实际使用较少，全部计算耗时大\n    \n怎么做：\n\t标注结果可能比需求类型多，对不需要评测的类型进行过滤"},"children":[]},{"data":{"id":"djo3brptdqo0","created":1782995984940,"text":"真值抽稀（降采样","note":"为什么：\n\t如果稠密化的结果全部传递给后端消耗太大\n    \n怎么做：\n\t只保留弯曲、拐角时的关键点能有效降低数据量"},"children":[]}]},{"data":{"id":"djmgdixb4a00","created":1782829677046,"text":"坐标转换","expandState":"collapse","note":"真值标注是自车坐标系下的 算法结果是基于odom坐标系下的 所以需要先进行一个坐标转换\t"},"children":[{"data":{"id":"djo4gisgy140","created":1782999178440,"text":"对齐时间戳","note":"目的：\n\t将真值转换成odom坐标系下的坐标\n\n问题：\n\t1.坐标转换需要用到自车的定位信息\n\t2.真值是通过图像获得然后进行标注的\n\t3.通常图像的帧率比定位低的多，而且标注进行抽帧\n\n解决：\n\t通过真值的时间戳找前后一定阈值内的定位信息进行匹配\n"},"children":[]},{"data":{"id":"dl3zez4cd6w0","created":1788266069455,"text":"相机坐标系转图像坐标系","note":"\n"},"children":[]},{"data":{"id":"dlhggva75mo0","created":1789634456136,"text":"图像转BEV","note":"一、铺设bev网格：\n\t1. 以每个相机为基准点，铺设一个指定规格，指定分辨率的网格（如长10m，宽6m，一格代表5cm）\n    2. 将每个相机铺设出的网格组合在一起，就是自车周围以5cm为单位的所有点坐标\n二、自车坐标系转相机坐标系：\n\t将每个相机铺设的网格点通过相机的外参矩阵转到对应相机坐标系下\n三、相机坐标系转图像坐标系：\n\t将相机坐标系下的网格点转换到图像坐标系下\n四、裁剪&过滤\n\t在图像坐标系下取出网格的外轮廓，过滤掉轮廓外的点\n五、临近搜索：\n\t留下来的标注真值计算其和图像坐标系下网格投影点的欧式距离，获取与其最近的网格点，然后取对应网格点在自车坐标系下的bev图像坐标\n"},"children":[]},{"data":{"id":"dll5oug6h8g0","created":1790010288852,"text":"图像坐标系转自车坐标系"},"children":[]},{"data":{"id":"djo4thbkfog0","created":1783000193976,"text":"自车坐标系转odom坐标系"},"children":[]}]}]},{"data":{"id":"djmgdsbba1s0","created":1782829697484,"text":"数据处理","layout_right_offset":{"x":-3.3333331015373915,"y":-1.6666665507686957},"expandState":"collapse","note":"官方标准通过 rosbag2_py 提供的 Reader进行数据处理"},"children":[{"data":{"id":"djn8kdwk3zc0","created":1782909205743,"text":"实例化官方 Reader ","note":"reader = rosbag2_py.SequentialReader()"},"children":[]},{"data":{"id":"djn8lu4slko0","created":1782909319434,"text":"设置存储选项","note":"指定路径和后端格式（ROS 2 默认是 sqlite3，新版本也支持 mcap）\n        storage_options = rosbag2_py.StorageOptions(\n            uri=self.bag_dir_path, \n            storage_id=\"sqlite3\"\n        )"},"children":[]},{"data":{"id":"djn8m6tx3mw0","created":1782909347074,"text":"设置转换选项","note":"读取原始序列化数据（保持 CDR 编码）\n        converter_options = rosbag2_py.ConverterOptions(\n            input_serialization_format=\"cdr\",\n            output_serialization_format=\"cdr\"\n        )"},"children":[]},{"data":{"id":"djn8mg9f9ls0","created":1782909367603,"text":"打开 Bag 文件","note":"reader.open(storage_options, converter_options)"},"children":[]},{"data":{"id":"djn8moyzbn40","created":1782909386562,"text":"获取 Bag 内所有话题的元数据","note":"建立“话题名”到“消息类型字符串”的映射字典\n        topic_types = reader.get_all_topics_and_types()\n        type_map = {topic.name: topic.type for topic in topic_types}\n"},"children":[]},{"data":{"id":"djn8n2couiw0","created":1782909415689,"text":"过滤报文（非必须","note":"如果配置了目标话题，设置过滤器以提高读取性能\n        if self.target_topics:\n            filter_options = rosbag2_py.StorageFilter(topics=self.target_topics)\n            reader.set_filter(filter_options)"},"children":[]},{"data":{"id":"djn8og0e5940","created":1782909523785,"text":"循环读取报文","note":"        while reader.has_next():\n            # 读取下一条原始报文：包含话题名、二进制数据、时间戳\n            topic_name, raw_data, timestamp = reader.get_next_message()\n            msg_type_str = type_map.get(topic_name)"},"children":[]},{"data":{"id":"djn8p7zfevc0","created":1782909584677,"text":"反序列化","note":"\n                msg_class = get_message(msg_type_str)\n                msg_obj = deserialize_message(raw_data, msg_class)\n                msg_dict = message_to_ordereddict(msg_obj)"},"children":[]}]},{"data":{"id":"djmftl2tew80","created":1782828114449,"text":"评测计算"},"children":[]},{"data":{"id":"djmfu63ne8g0","created":1782828160212,"text":"结果汇总"},"children":[]}]}]},{"data":{"id":"djmffmy8zds0","created":1782827021428,"text":"VLM 找出口"},"children":[{"data":{"id":"djmfjady29c0","created":1782827307536,"text":"模型特点","expandState":"expand"},"children":[{"data":{"id":"dm002r0koa80","created":1791517851167,"text":"优点","expandState":"collapse"},"children":[{"data":{"id":"djmfvzyi3m00","created":1782828303569,"text":"跨模态对齐与融合（Cross-Modal Alignment）","note":"• 特点：VLM 能够将“视觉像素”和“文本Token”映射到同一个联合向量空间中。\n• 表现：它不仅能“看到”画面（如一只猫），还能将这个画面与文本里的“猫”字、以及“猫喜欢抓老鼠”等背景知识完美匹配。这种对齐让模型不仅有视觉感知力，更有认知和推理能力"},"children":[]},{"data":{"id":"djmfyakitsw0","created":1782828483396,"text":"强大的零样本泛化能力（Zero-Shot Generalization）","note":"• 特点：传统的计算机视觉模型（如 ResNet、YOLO）需要针对特定任务（如识别车型、检测人脸）进行专门的标注数据训练。\n• 表现：VLM（如 CLIP、Qwen2-VL）在海量互联网图文对上进行预训练后，无需微调就能直接理解从未见过的全新场景和复杂指令，展现出极强的“通识”能力。\n\n"},"children":[]},{"data":{"id":"djmg1338j0o0","created":1782828702206,"text":"支持任意交错的输入与输出（Any-to-Any Text-Image Flow）","note":"• 特点：现代 VLM 支持图文混排（Interleaved Input）的输入方式。\n• 表现：你可以给模型输入“图片A + 文本问题 + 图片B + 针对两张图的对比要求”，模型能够无缝理解多张图片之间的逻辑、前后顺序或时间因果关系，并输出连贯的文本。"},"children":[]},{"data":{"id":"djmg445i04g0","created":1782828939612,"text":"具备精细的“空间与局部”感知（Fine-Grained Perception）","note":"• 特点：新一代 VLM 已经从早期的“只能看懂大概轮廓”，演进到能看清极其精细的局部细节。\n• 表现：\n\t• 文档与图表理解（OCR/InfoVQA）：能够精准识别图片中密密麻麻的小字、扫描财报里的表格、计算坐标轴曲线。\n\t• 目标定位（Grounding）：可以直接在文本中输出物体的像素坐标（Bounding Box），不仅知道“有什么”，还知道“在哪里”。"},"children":[]},{"data":{"id":"dlzzz4a48140","created":1791517566585,"text":"作为具身智能的“感知与决策大脑”","note":"• 特点：VLM 是向更高级的 VLA（视觉-语言-动作）模型演进的基石。\n• 表现：在机器人和智能汽车领域，VLM 充当了“大白”式的通用大脑。它负责看懂周围的物理世界（如“桌上有个水杯，后面有把剪刀”），理解人类的自然语言意图（如“把危险的东西拿开”），并为接下来的机械臂抓取或车辆行驶规划提供高层级的决策依据"},"children":[]},{"data":{"id":"dm00kq2oo7c0","created":1791519259672,"text":"可以用来进行数据清洗","note":"算法工程师可以给云端 VLM 下达自然语言指令：“请帮我找出所有‘夜间下雨天、且前方有逆行电动车’的视频片段。”VLM 能够自动检索、切片并完成高精度的场景标签分类，将智驾数据清洗效率提升数倍"},"children":[]}]},{"data":{"id":"dm002v7y0a00","created":1791517860319,"text":"缺点","expandState":"collapse"},"children":[{"data":{"id":"dm002zdz2080","created":1791517869391,"text":"“幻觉”问题（Hallucination）","note":"表现：模型经常会胡编乱造。比如当你提问引导时，模型可能会言之凿凿地描述一个不存在的物体，或者把颜色说错\n• 物体存在幻觉（Object Existence）：图片里明明没有猫，模型言之凿凿地描述“一只黑猫躺在沙发上”。\n• 属性幻觉（Attribute Hallucination）：图片里的人穿着蓝色衣服，模型却说是红色；或者把方形的指示牌说成圆形。\n• 关系幻觉（Relationship Hallucination）：图片里是“狗在追猫”，模型看图说话却写成“猫在猛烈地追赶一只狗”。\n\n\n原因：VLM 产生幻觉并非随机错误，而是由其架构特征、训练数据以及模态冲突共同导致的\n\n① LLM 强大的“文本先验惯性”（过度脑补）\n\n• 原理：VLM 的大脑是一个在海量文本上预训练过的 LLM。LLM 的本质是根据统计概率预测下一个 Token（词）。\n• 后果：如果训练数据中经常出现“冰激凌融化了”、“马路上有汽车”，当模型在图片中看到冰激凌或马路时，它的文本大脑就会自动触发强大的思维定势，直接忽略视觉编码器传来的真实像素，开始盲目“脑补”后续情节。\n\n② 视觉 Token 的“语义退化”与信息丢失\n\n• 原理：图像通过 Vision Encoder（视觉编码器）并经过 Projector（连接器）压缩后，成千上万的像素点被脱敏、浓缩成了几十个或上百个视觉 Tokens。\n• 后果：在这个极度压缩的过程中，物体的边缘、细微颜色差别、微小的文字等关键细节丢失了。大语言模型收到的视觉信号变成了“马赛克式的模糊概念”，只能靠文本能力去“猜”，从而引发幻觉。\n\n③ 训练数据的质量缺陷（数据偏见）\n• 原理：VLM 依赖互联网上图文对（Image-Text Pairs）进行预训练。但网络上的图文对往往是“图文不严格匹配”的。\n• 后果：例如，一张风景图配文却是发言人的演讲稿。模型长期在这些“低对齐度”的数据中摸爬滚打，误以为视觉和文本不需要严格一一对应，削弱了其对视觉事实的敬畏心。\n","expandState":"collapse"},"children":[{"data":{"id":"dm013ic9t140","created":1791520731757,"text":"强迫其每一句文本都必须在视觉 Token 中找到强相关对应","note":"约束 LLM 盲目续写的能力，强迫其每一句文本都必须在视觉 Token 中找到强相关对应"},"children":[]}]},{"data":{"id":"dm003lwo4yo0","created":1791517918411,"text":"资源消耗巨大与推理延迟高（High Latency & Costs","note":"• 表现：VLM 的运行速度通常比纯文本 LLM 慢得多，显存占用极大，难以做到真正的“实时响应”。\n• 原因：一张高分辨率的图片在被视觉编码器（如 ViT）切片后，会转化为数百甚至上千个 Visual Tokens。这意味着输入一张图的算力消耗和上下文窗口占用，相当于输入了一篇几千字的长文。在需要高频交互的场景（如自动驾驶、机器人控制）中，高延迟是致命的\n\n优化方案：\n\n  1. 算法与数据层：视觉 Token 暴力瘦身（最有效）\n\nVLM 延迟高的根本原因在于视觉 Token 数量呈平方级增长（一张图动辄 1024 个 Token）。通过减少视觉 Token 数量，可以成倍降低大语言模型（LLM）的计算开销。\n• 动态分辨率与自适应切片（Dynamic Resolution）：不盲目追求全图超清。仅在车辆前向远端、红绿灯等“关键 ROI（感兴趣区域）”使用高分辨率切片，对天空、车内仪表盘等无用区域进行极低分辨率降采样或直接裁剪。\n• 视觉 Token 聚合与剪枝（Token Merging/Pruning）：在连接器（Connector）中引入算法（如 ToMe 或 Q-Former），将空间中语义高度相似的视觉 Token（例如连续的沥青路面、大片白墙）进行合并，将 1000+ 个 Token 压缩至 64~128 个，推理速度可直接提升 3~5 倍。\n\n2. 架构层演进：从“大模型”到“大小脑双通路结构”\n\n在智驾实际控制中，不可能每一帧都让几十亿参数的 VLM 去做长文本推理。行业普遍采用“快慢路径分工”的架构设计：\n• 小脑（快路径 - 传统小模型/端到端网络）：运行参数量在几千万到几亿级别的轻量级网络（如精简版 BEV 模型），以 20Hz+（50ms） 的频率负责实时的障碍物检测、车辆跟驰和紧急制动。\n• 大脑（慢路径 - VLM）：参数量在 1.5B 到 7B 的 VLM 以 2Hz~5Hz（200ms~500ms） 的较低频率异步运行，只负责高层级的语义理解（如读懂临时路牌、交警手势）。VLM 输出的语义特征作为“提示信息（Prompt）”注入给快路径，如此既保证了安全性，又缓解了算力焦虑。\n\n3. 量化与极限压缩：适配车规级芯片\n\n大模型必须经过瘦身才能塞进车端芯片（如 NVIDIA Orin-X、华为 MDC、高通骁龙 8650 等）。\n• INT4/INT8 量化：将模型权重从 FP16（16位浮点数）量化为 INT8（8位整数）甚至 INT4。对视觉编码器和 LLM 进行混合精度量化，在精度损失可控（通常小于 1%~2%）的前提下，吞吐量可提升 2~4 倍，显存占用暴降 50% 以上。\n• 知识蒸馏（Knowledge Distillation）：用云端 70B 或 7B 的“教师 VLM”去训练一个专门针对智驾场景裁剪的 1.5B 或 0.5B “学生 VLM”，使其继承长尾场景的常识推理能力，同时具备极轻量级的身形\n\n\n4. 工程与部署加速：压榨硬件每一滴性能\n\n利用前沿的 LLM 推理引擎和硬件底层优化，可以显著消减首字延迟（Prefill Time）和生成延迟（Decoding Time）。\n• 流水线并行与 FlashAttention-3：在车端部署时，使用基于 TensorRT-LLM 或 vLLM 的定制化推理引擎。开启 FlashAttention 优化，大幅降低多模态特征矩阵相乘时的显存带宽瓶颈。\n• 视觉特征缓存（KV Cache 优化）：在处理车载连续视频流时，前后帧图像有大量背景是重合的。通过复用前序帧的视觉 KV Cache，避免对背景像素进行重复的 Vision Encoder 计算，做到“增量推理”。\t","expandState":"collapse"},"children":[{"data":{"id":"dm012trz2xc0","created":1791520678287,"text":"1. 算法与数据层：视觉 Token 暴力瘦身（最有效）"},"children":[]},{"data":{"id":"dm0134azvnc0","created":1791520701205,"text":"2. 架构层演进：从“大模型”到“大小脑双通路结构”","note":"• 小脑（快路径 - 传统小模型/端到端网络）：运行参数量在几千万到几亿级别的轻量级网络（如车端的 BEV 网络、机器人的运动控制网络）。它以 20Hz+（50ms） 的超高频率负责实时的障碍物检测、车辆跟驰和紧急制动，确保绝对安全。\n• 大脑（慢路径 - VLM）：参数量在 1.5B 到 7B 的 VLM 异步运行，频率降低到 2Hz~5Hz。它不直接控制刹车和方向，只负责高层级的语义理解（如“读懂临时管制路牌”、“理解交警的手势”）。VLM 输出的语义特征作为“提示信息（Prompt）”注入给快路径，实现了算力与实时性的完美平衡。"},"children":[]},{"data":{"id":"dm01393mpc80","created":1791520711643,"text":"3. 量化与极限压缩：适配车规级芯片"},"children":[]},{"data":{"id":"dm013caxpu00","created":1791520718615,"text":"4. 工程与部署加速：压榨硬件每一滴性能"},"children":[]}]},{"data":{"id":"dm004608ly80","created":1791517962162,"text":"精细空间推理与物理常识缺失（Spatial & Physical Blindspots","note":"• 表现\n\t• 数数能力差（Counting）：面对密集排列的物体（如一盘车厘子、一排货架），VLM 很难数对确切的数量。\n\t• 空间方位混乱：容易搞反“左边/右边”、“前后/里外”以及物体的层叠覆盖关系。\n\t• 缺乏物理世界常识：无法准确评估物体的重量、材质硬度、重心或运动趋势（例如无法仅凭图片判断一个杯子放在桌角是否快要掉下去）。\n","expandState":"collapse"},"children":[{"data":{"id":"dm0169vlodc0","created":1791520948427,"text":"3D 位置编码与多模态特征融合（解决空间推理）","note":"• 引入 3D 旋转位置编码（3D-RoPE）：升级大模型底层的注意力机制，让每一个视觉 Token 都能原生携带其在三维空间中的 (X, Y) 坐标和视频中的 (Time) 时间轴信息，大幅提升其在视觉测距和轨迹追踪上的绝对精度。\n• 强行融合 3D 点云/深度图：不再仅仅输入相机图片，而是将激光雷达（LiDAR）的 3D 深度信息或双目相机的深度图，通过线性层变换后与文本 Token 拼在一起输入给大模型，让模型原生具备“远、近、深、浅”的概念。\n"},"children":[]},{"data":{"id":"dm0174bmeso0","created":1791521014699,"text":"转向 VLA 架构与世界模型（解决物理常识）","note":"• VLA（视觉-语言-动作）闭环：模型不再输出文本，而是直接输出离散化的动作 Token（控制量，如关节速度、末端位姿），实现端到端的闭环控制。\n• 世界模型（World Model）前向预测：世界模型的核心是让大模型具备“预测未来”的能力。当输入当前画面和预定动作时，大模型会在内部隐藏层中去预测接下来 1~3 秒物理世界的像素演变。如果模型在“脑海”中预测出“水杯会倒”或“车辆会撞上马路牙子”，它就会在动作生成前强行拦截并修正指令，从根本上解决了静态模型缺乏物理常识的问题。\n"},"children":[]}]},{"data":{"id":"dm004pvy3eg0","created":1791518005438,"text":"文本语义与视觉特征的“不对齐”（Modality Disconnection）","note":"• 表现：模型能看懂图片，也能看懂文字，但无法完美地将两者组合成复杂的逻辑。\n• 经典反例（Negation & Relation）：如果你给它看一张“狗在追猫”的图，并问它“这是猫在追狗吗？”，或者让它找“没有红苹果的盘子”，VLM 经常会因为捕捉到“猫、狗、追”或“红苹果”等强特征字眼而给出完全相反的错误答案。它对否定句、被动句和复杂的修饰关系理解较弱。"},"children":[]},{"data":{"id":"dm006mvbguo0","created":1791518155598,"text":"高分辨率与多图/视频处理能力受限","note":"• 表现：虽然很多新模型宣称支持“长视频”或“超清图片”，但实际输入时，系统为了不挤爆显存，通常会对图片进行严重的下采样（压缩分辨率）或抽帧。\n• 后果：这导致模型在面对医疗影像（X光片细节）、工业自动化质检（微小划痕）、或者复杂长视频推理时，由于关键像素丢失而无法做出正确判断"},"children":[]}]}]},{"data":{"id":"djmfj2hhtnc0","created":1782827290336,"text":"测试设计","expandState":"expand"},"children":[{"data":{"id":"djmfr91h3tc0","created":1782827931518,"text":"场景设计","note":"依据模型应用场景和特性设计测试的场景，采集对应的场景数据","expandState":"collapse"},"children":[{"data":{"id":"dm01k2wvprs0","created":1791522030365,"text":"业务场景全覆盖","expandState":"collapse"},"children":[{"data":{"id":"dm026uf8gco0","created":1791523814260,"text":"位置"},"children":[]},{"data":{"id":"dm026wcq2n40","created":1791523818462,"text":"朝向"},"children":[]},{"data":{"id":"dm027ps7yf40","created":1791523882525,"text":"数量"},"children":[]},{"data":{"id":"dm027606qvc0","created":1791523839471,"text":"材质"},"children":[]},{"data":{"id":"dm026xookig0","created":1791523821361,"text":"单图像"},"children":[]},{"data":{"id":"dm027297n6w0","created":1791523831310,"text":"单文本"},"children":[]},{"data":{"id":"dm0274b46hk0","created":1791523835779,"text":"图像文本组合"},"children":[]},{"data":{"id":"dm026cdq4s80","created":1791523774986,"text":"复杂语句"},"children":[]},{"data":{"id":"dm026gpastk0","created":1791523784393,"text":"复杂图像"},"children":[]}]},{"data":{"id":"dm01kf8o6w80","created":1791522057200,"text":"耦合环境要素","expandState":"collapse"},"children":[{"data":{"id":"dm0286lliuo0","created":1791523919130,"text":"光线"},"children":[]},{"data":{"id":"dm0287li7io0","created":1791523921301,"text":"天气"},"children":[]},{"data":{"id":"dm0289awyr40","created":1791523925015,"text":"脏污"},"children":[]},{"data":{"id":"dm028a49mrk0","created":1791523926789,"text":"地上地下"},"children":[]}]},{"data":{"id":"dm010t7aegg0","created":1791520520308,"text":"幻觉场景构建","note":"解决误检，核心是\n1. 提升视觉编码器的分辨率和分类精度2. 喂更多相似视觉数据","expandState":"collapse"},"children":[{"data":{"id":"dm01n2nwctc0","created":1791522264915,"text":"语义模糊","note":"有歧义的图片或者文本内容"},"children":[]},{"data":{"id":"dm01n7ch91k0","created":1791522275108,"text":"否定句"},"children":[]},{"data":{"id":"dm0220am6ko0","created":1791523435220,"text":"排他句"},"children":[]},{"data":{"id":"dm029wnxuew0","created":1791524054232,"text":"包含关系语句"},"children":[]}]},{"data":{"id":"dm01lapa9hs0","created":1791522125684,"text":"问题场景集","expandState":"collapse"},"children":[{"data":{"id":"dm028hv8dqw0","created":1791523943657,"text":"后端问题集"},"children":[]}]},{"data":{"id":"dm01lnq7gmo0","created":1791522154038,"text":"长尾场景集构建","expandState":"collapse"},"children":[{"data":{"id":"dm02280ird40","created":1791523452024,"text":"遮挡"},"children":[]},{"data":{"id":"dm022bgppnk0","created":1791523459534,"text":"重复"},"children":[]},{"data":{"id":"dm022h50bs00","created":1791523471887,"text":"图像&文字 模糊"},"children":[]}]},{"data":{"id":"dm02uexksds0","created":1791525661280,"text":"无目标误检场景"},"children":[]}]},{"data":{"id":"djmflj33kts0","created":1782827483199,"text":"指标设计","expandState":"collapse"},"children":[{"data":{"id":"dm0291rnzaw0","created":1791523986977,"text":"准确率","note":"判断检测的结果对不对的比例\n\n正确的正例(TP)/模型检出的总数（TP+FP）"},"children":[]},{"data":{"id":"dm0294y62ug0","created":1791523993901,"text":"召回率","note":"检测目标有没有被漏掉\n\n正确的正例（TP）/物理存在的总数（TP+FN）"},"children":[]},{"data":{"id":"dm02961577s0","created":1791523996258,"text":"误检率","note":"实际不存在的目标被检出的比例\n\n错误的检出帧数/总帧数"},"children":[]}]}]},{"data":{"id":"djmfjhw20y80","created":1782827323868,"text":"测试实现","expandState":"collapse"},"children":[{"data":{"id":"djmfsw3fa5c0","created":1782828060066,"text":"数据采集"},"children":[]},{"data":{"id":"djmft0m55200","created":1782828069905,"text":"数据标注","expandState":"expand"},"children":[{"data":{"id":"djn5y30l1s00","created":1782901815810,"text":"VLM标注","expandState":"collapse","note":"1、时空对齐：把一整条路测片段（如 30 秒的视频和点云）拼起来，利用高精定位（SLAM）和组合导航将所有帧的点云“缝合”成一个全局连续的 4D 静态世界大点云地图\n2、动态剔除：算法通过多帧前后追踪（Multi-frame Tracking），自动把路上行驶的背景车等动态物体的轨迹剥离出来。\n3、大模型预标注：用多视角大模型（如 NeRF、3DGS、自动标注大模型）直接将空间切碎为 4D 占用体素网格（Voxel Grid），或者自动生成连续的 3D 轨迹流。\n4、人工回放修剪：标注员不再一帧一帧画框，而是直接在时间轴上微调物体的轨迹曲线或修正立体空间的网格标签（占用/空闲"},"children":[{"data":{"id":"djn6qs51auw0","created":1782904064696,"text":"优点","layout_right_offset":{"x":-8.333332753843706,"y":36.666664116912216}},"children":[{"data":{"id":"djn6qtm8mn40","created":1782904067913,"text":"有时序信息","note":"不是单帧信息而是多帧缝合，多帧的点云根据时序信息融合在一起\n1、能解决短暂遮挡场景\n2、能解决不规则的异形物体"},"children":[]},{"data":{"id":"djn6tdlf4bc0","created":1782904268127,"text":"精度更高","note":"抛弃了原有3D标注的方框概念，4D是将其切割成细小方块，为方块标注占据状态，对于异形物体的形状表达更精细"},"children":[]}]},{"data":{"id":"djn705owunc0","created":1782904799473,"text":"缺点","layout_right_offset":{"x":-1.6666665507686957,"y":23.333331710762423}},"children":[{"data":{"id":"djn70c8kluw0","created":1782904813723,"text":"标注成本高"},"children":[]},{"data":{"id":"djn70erq5nk0","created":1782904819234,"text":"标注工具要求高"},"children":[]}]}]}]},{"data":{"id":"djmft6t9wx40","created":1782828083397,"text":"真值处理","expandState":"expand"},"children":[{"data":{"id":"djn8unwrd6o0","created":1782910011165,"text":"真值下载"},"children":[]},{"data":{"id":"djna13pk5g80","created":1782913336853,"text":"真值过滤","note":"\n","expandState":"expand"},"children":[]}]},{"data":{"id":"djmgdsbba1s0","created":1782829697484,"text":"数据处理","layout_right_offset":{"x":-3.3333331015373915,"y":-1.6666665507686957},"expandState":"collapse","note":"官方标准通过 rosbag2_py 提供的 Reader进行数据处理"},"children":[{"data":{"id":"djn8kdwk3zc0","created":1782909205743,"text":"实例化官方 Reader ","note":"reader = rosbag2_py.SequentialReader()"},"children":[]},{"data":{"id":"djn8lu4slko0","created":1782909319434,"text":"设置存储选项","note":"指定路径和后端格式（ROS 2 默认是 sqlite3，新版本也支持 mcap）\n        storage_options = rosbag2_py.StorageOptions(\n            uri=self.bag_dir_path, \n            storage_id=\"sqlite3\"\n        )"},"children":[]},{"data":{"id":"djn8m6tx3mw0","created":1782909347074,"text":"设置转换选项","note":"读取原始序列化数据（保持 CDR 编码）\n        converter_options = rosbag2_py.ConverterOptions(\n            input_serialization_format=\"cdr\",\n            output_serialization_format=\"cdr\"\n        )"},"children":[]},{"data":{"id":"djn8mg9f9ls0","created":1782909367603,"text":"打开 Bag 文件","note":"reader.open(storage_options, converter_options)"},"children":[]},{"data":{"id":"djn8moyzbn40","created":1782909386562,"text":"获取 Bag 内所有话题的元数据","note":"建立“话题名”到“消息类型字符串”的映射字典\n        topic_types = reader.get_all_topics_and_types()\n        type_map = {topic.name: topic.type for topic in topic_types}\n"},"children":[]},{"data":{"id":"djn8n2couiw0","created":1782909415689,"text":"过滤报文（非必须","note":"如果配置了目标话题，设置过滤器以提高读取性能\n        if self.target_topics:\n            filter_options = rosbag2_py.StorageFilter(topics=self.target_topics)\n            reader.set_filter(filter_options)"},"children":[]},{"data":{"id":"djn8og0e5940","created":1782909523785,"text":"循环读取报文","note":"        while reader.has_next():\n            # 读取下一条原始报文：包含话题名、二进制数据、时间戳\n            topic_name, raw_data, timestamp = reader.get_next_message()\n            msg_type_str = type_map.get(topic_name)"},"children":[]},{"data":{"id":"djn8p7zfevc0","created":1782909584677,"text":"反序列化","note":"\n                msg_class = get_message(msg_type_str)\n                msg_obj = deserialize_message(raw_data, msg_class)\n                msg_dict = message_to_ordereddict(msg_obj)"},"children":[]}]},{"data":{"id":"djmftl2tew80","created":1782828114449,"text":"评测计算"},"children":[]},{"data":{"id":"djmfu63ne8g0","created":1782828160212,"text":"结果汇总"},"children":[]}]}]},{"data":{"id":"djmfdm6ruhk0","created":1782826863038,"text":"中心线"},"children":[]},{"data":{"id":"djmfdvj4uzk0","created":1782826883377,"text":"引导线"},"children":[]},{"data":{"id":"djmfel2n13s0","created":1782826938976,"text":"室内外识别"},"children":[]},{"data":{"id":"djmff3llb3c0","created":1782826979304,"text":"出入口识别"},"children":[]},{"data":{"id":"djmfbj099so0","created":1782826699386,"text":"鱼眼障碍物"},"children":[]},{"data":{"id":"djmfbpg3dkg0","created":1782826713404,"text":"泊车bev"},"children":[]},{"data":{"id":"djmfbslnots0","created":1782826720271,"text":"泊车车位"},"children":[]}]},{"data":{"id":"dlzzkvx4iqw0","created":1791516451287,"text":"后处理评测","expandState":"expand"},"children":[{"data":{"id":"djmfcrhv5jc0","created":1782826796229,"text":"园区boundary"},"children":[]},{"data":{"id":"djmffct3eq80","created":1782826999349,"text":"进出园区切图"},"children":[]},{"data":{"id":"djmffx44ns00","created":1782827043551,"text":"导航功能","note":"扎标、切图、重规划、重导航、默认目的地、切换目的地、目的地优先级、能源车位"},"children":[]}]}]}]},{"data":{"id":"djlc57vs9nk0","created":1782716181699,"text":"工作内容","expandState":"expand"},"children":[{"data":{"id":"djlcg6r62jk0","created":1782717041249,"text":"版本交付","note":"1、分析版本用途&交付范围，设计版本总体评测策略以及需求验收策略\n2、构建版本冒烟用例、快评集、细分场景集以及cornercase集\n3、评测分层，分析版本用途和转测时间设计合理测试规模，高效满足版本迭代需求，及时拦截算法模型&需求问题","expandState":"collapse"},"children":[{"data":{"id":"djmcfmhs5m80","created":1782818557103,"text":"版本类型","expandState":"collapse"},"children":[{"data":{"id":"djmbzsjljv40","created":1782817316447,"text":"重要伐点版本","note":"验证内容&通过标准\n1、依据伐点的功能交付范围进行全量功能验证，交付功能达到需求准出标准\n2、验证算法性能满足准出标准\n3、系统基础性能、稳定性等符合交付规格\n4、单点问题修复验证通过，无负向收益（负收益不予通过\n\n特殊情况：\n需要分析负收益的影响范围、场景以及概率等进行决策，决策问题遗留需要有问题根因分析，问题解决方案以及问题修复计划\n"},"children":[]},{"data":{"id":"djmbzxqvtxc0","created":1782817327771,"text":"日常迭代版本","note":"验证内容&通过标准\n1、新增功能验证，需求满足交付标准\n2、基础功能冒烟，验证基础功能完善\n3、修复问题验证，正收益大于负收益（负收益需要有修复计划）\n\n"},"children":[]},{"data":{"id":"djmc055h4w00","created":1782817343891,"text":"临时测试版本","note":"主要针对单点的临时问题验证或者方案验证"},"children":[]}]},{"data":{"id":"djmcfs5edcg0","created":1782818569415,"text":"交付件","expandState":"collapse"},"children":[{"data":{"id":"djmcg2hhfz40","created":1782818591913,"text":"测试策略","expandState":"collapse"},"children":[{"data":{"id":"djmcgif2rso0","created":1782818626596,"text":"测试范围&目标","note":"1、明确版本用途和本次测试覆盖范围\n2、明确版本交付范围内所需达到的质量标准"},"children":[]},{"data":{"id":"djmcgr8r0tc0","created":1782818645805,"text":"测试环境&数据","note":"说明测试环境和测试数据的来源以及测试数据量"},"children":[]}]},{"data":{"id":"djmcg5zkf740","created":1782818599537,"text":"测试报告","expandState":"collapse"},"children":[{"data":{"id":"djmclua2zxk0","created":1782819044236,"text":"报告概述","note":"1、报告名称\n2、版本信息\n3、测试时间\n4、测试结论"},"children":[]},{"data":{"id":"djmcmpfpwls0","created":1782819112057,"text":"测试情况","note":"1、需求验收结果\n2、感知性能评估指标\n3、系统性能&稳定性指标\n4、负收益影响分析、场景分析、概率分析（如有）\n5、竞品对比报告（如有）"},"children":[]},{"data":{"id":"djmcnx3s10o0","created":1782819207114,"text":"遗留问题&风险分析","note":"1、新增&遗留问题汇总\n2、遗留问题风险点&规避措施"},"children":[]}]}]}]},{"data":{"id":"djlcgf16qwg0","created":1782717059269,"text":"模型评测","note":"验证上线模型的性能优化&问题修复结果","expandState":"expand"},"children":[{"data":{"id":"djmcpxd99g80","created":1782819364415,"text":"模型评测方案","expandState":"collapse"},"children":[{"data":{"id":"djmec85dyiw0","created":1782823933006,"text":"测试方案设计","note":"依据模型特性和功能应用场景设计测试方案和相应的测试指标"},"children":[]},{"data":{"id":"djmec85dyiw0","created":1782823933006,"text":"测试场景设计","note":"依据模型应用场景和特性设计测试的场景，采集对应的场景数据"},"children":[]},{"data":{"id":"djmecd3yf5k0","created":1782823943804,"text":"评测代码开发","note":"依据测试设计进行对应指标的开发"},"children":[]}]},{"data":{"id":"djmecn36p400","created":1782823965524,"text":"用例集构建","note":"模型不同的迭代范围和程度对测试用例集进行不同量级的划分，快速高效的发现问题，主要应该包括以下层级\n1、后冒烟用例集（1h-2h），旨在快速评定模型基本功能和基础性能指标\n2、快评集（4h-8h），适量基础场景数据，评定模型基本场景和日常工况下的性能指标\n3、全量集（8h-24h），全量场景和极端工况下的测试数据，全面评定模型各个场景和工况下的性能指标\n4、专项集（1h-8h），针对模型特点或者专项优化场景设计的数据集合，可能是某个专项场景、可能是模型误检、可能是问题数据等","expandState":"collapse"},"children":[{"data":{"id":"dlzzf4pqj2g0","created":1791516000246,"text":"后冒烟（1-2h"},"children":[]},{"data":{"id":"dlzzfdjyjag0","created":1791516019488,"text":"快评集（4-8h"},"children":[]},{"data":{"id":"dlzzfk15mbc0","created":1791516033588,"text":"全量集（8-24h"},"children":[]},{"data":{"id":"dlzzfrc9vts0","created":1791516049498,"text":"专项集（1-8h"},"children":[]}]}]},{"data":{"id":"djlcgu6nzko0","created":1782717092252,"text":"功能需求","expandState":"collapse"},"children":[{"data":{"id":"djmcxxdasbk0","created":1782819991331,"text":"需求串讲","note":"se串讲需求设计思路、功能逻辑和交付规格等"},"children":[]},{"data":{"id":"djmcy3566w80","created":1782820003900,"text":"测试设计","note":"依据设计文档进行测试设计，包括\n1、需求分析，明确功能边界，对需求范围内进行功能点映射\n2、测试场景设计，通过功能的设计理念抽象出使用场景然后进行实例化的具体场景设计\n3、软硬件接口与系统性能稳定性设计\n4、预期输出&测试指标\n5、故障注入、极端工况"},"children":[]},{"data":{"id":"djmd4iyymy80","created":1782820508538,"text":"反串讲","note":"同se与开发进行测试设计串讲，对齐测试用例、测试范围、准出标准等"},"children":[]},{"data":{"id":"djmcya6ubk80","created":1782820019239,"text":"测试执行","note":"1、依据测试设计生成测试用例\n2、依据测试用例进行进行测试执行\n3、记录测试用例执行情况、结果、问题"},"children":[]},{"data":{"id":"djmcyc1u3cw0","created":1782820023290,"text":"测试报告","expandState":"collapse"},"children":[{"data":{"id":"djmclua2zxk0","created":1782819044236,"text":"报告概述","note":"1、报告名称\n2、版本信息\n3、测试时间\n4、测试结论"},"children":[]},{"data":{"id":"djmcmpfpwls0","created":1782819112057,"text":"测试情况","note":"1、需求验收结果\n2、感知性能评估指标\n3、系统性能&稳定性指标\n4、负收益影响分析、场景分析、概率分析（如有）\n5、竞品对比报告（如有）"},"children":[]},{"data":{"id":"djmcnx3s10o0","created":1782819207114,"text":"遗留问题&风险分析","note":"1、新增&遗留问题汇总\n2、遗留问题风险点&规避措施"},"children":[]}]}]},{"data":{"id":"djlch05uwn40","created":1782717105264,"text":"多车型交付","expandState":"collapse"},"children":[{"data":{"id":"djmdilam5u00","created":1782821610695,"text":"车型数据","expandState":"collapse"},"children":[{"data":{"id":"djmdj3hqm9s0","created":1782821650308,"text":"场景设计","note":"依据新车型的传感器部署、硬件规格、底软&平台能力等非算法相关的差异化部分进行分析，设计评估新车型的算法性能需要的评测场景和数据量"},"children":[]},{"data":{"id":"djmdj50zcqo0","created":1782821653648,"text":"数据采集"},"children":[]}]},{"data":{"id":"djmdizpomvs0","created":1782821642081,"text":"车型报告","expandState":"collapse"},"children":[{"data":{"id":"djmdj85ouvk0","created":1782821660463,"text":"评测执行"},"children":[]},{"data":{"id":"djmdjlnggwo0","created":1782821689836,"text":"问题分析&优化","note":"分析评测结果，提取不符合预期的场景数据，分析影响因素，推动算法优化"},"children":[]}]}]}]},{"data":{"id":"dlzzm855q7s0","created":1791516556258,"text":"泊车功能"},"children":[{"data":{"id":"dlzzmax83zs0","created":1791516562309,"text":"APA泊车辅助"},"children":[]},{"data":{"id":"dlzzmg1yly80","created":1791516573479,"text":"RAPA遥控泊车"},"children":[]},{"data":{"id":"dlzzmj6t7ow0","created":1791516580303,"text":"AVP代客泊车","note":"Automated Valet Parking"},"children":[]}]}]},{"data":{"id":"dlkprnbutkg0","created":1789965370687,"text":"测试体系"},"children":[{"data":{"id":"djlc5nb8cww0","created":1782716215285,"text":"软件测试理论基础","expandState":"expand","note":"定义：\n\t使用人工或自动手段，来检测某个系统或者程序的过程\n    \n目的：\n\t\t测试是程序的执行过程，目的在于发现错误和检验它是否满足预期的需求或弄清预期结果与实际结果之间的差别\n\n原则：\n\t1. 确保产品功能完整\n\t2. 确保产品满足性能和效率的要求\n\t3. 确保产品是健壮的和适应用户环境的\n    \n"},"children":[{"data":{"id":"djlc859p07k0","created":1782716411103,"text":"生命周期","note":"软件生存周期是软件开发全部过程,从可行性研究到需求分析、软件设计、编码、测试、软件发布维护的过程,直到最后由于缺少维护而逐渐消亡,这样的一个过程，称为\"生命周期模型\"（Life Cycle Model）。\n"},"children":[]},{"data":{"id":"djlc86ot9ls0","created":1782716414193,"text":"测试技术","expandState":"collapse"},"children":[{"data":{"id":"dlllzlmnj340","created":1790056269416,"text":"白盒测试","expandState":"collapse"},"children":[{"data":{"id":"dlllzmuo7bs0","created":1790056272078,"text":"逻辑&分支覆盖"},"children":[]},{"data":{"id":"dlllzpv9mq80","created":1790056278644,"text":"循环覆盖"},"children":[]},{"data":{"id":"dlllzt8yjyo0","created":1790056286003,"text":"基本路径覆盖"},"children":[]},{"data":{"id":"dllm2i462co0","created":1790056496861,"text":"打桩测试"},"children":[]}]},{"data":{"id":"dlllzu7oo6g0","created":1790056288102,"text":"黑盒测试","expandState":"collapse"},"children":[{"data":{"id":"dlllzylejgg0","created":1790056297639,"text":"边界值分析"},"children":[]},{"data":{"id":"dlllzzlum5s0","created":1790056299843,"text":"等价类划分"},"children":[]},{"data":{"id":"dllm2uz68l40","created":1790056524857,"text":"正交排列"},"children":[]},{"data":{"id":"dllm0908rao0","created":1790056320304,"text":"状态图"},"children":[]},{"data":{"id":"dllm06tvfq80","created":1790056315565,"text":"因果图"},"children":[]},{"data":{"id":"dllm0bj0ols0","created":1790056325793,"text":"测试大纲"},"children":[]},{"data":{"id":"dllm0dj8dtc0","created":1790056330159,"text":"随机测试场景"},"children":[]}]},{"data":{"id":"dllmdtkwfeo0","created":1790057383823,"text":"灰盒测试"},"children":[]},{"data":{"id":"dllme2sf3rs0","created":1790057403869,"text":"模糊测试","expandState":"expand","note":"随机或刻意生成一些异常数据，验证平台稳定性"},"children":[{"data":{"id":"dllm0424g4g0","created":1790056309534,"text":"故障注入"},"children":[]}]},{"data":{"id":"dllmf1d3vio0","created":1790057479130,"text":"monkey测试","note":"随机、高频、无序的触发hmi界面 看是否会有奔溃或异常"},"children":[]}]},{"data":{"id":"dllm1zylvz40","created":1790056457342,"text":"测试目的"},"children":[{"data":{"id":"dllm5ordeps0","created":1790056746417,"text":"功能性测试","expandState":"collapse"},"children":[{"data":{"id":"dllm7axbnyw0","created":1790056873030,"text":"单元测试"},"children":[]},{"data":{"id":"dllm7fj9trc0","created":1790056883065,"text":"接口测试"},"children":[]},{"data":{"id":"dllm7god46g0","created":1790056885549,"text":"冒烟测试"},"children":[]},{"data":{"id":"dllm7ju8l4o0","created":1790056892435,"text":"业务功能测试"},"children":[]},{"data":{"id":"dllm7hvwrg00","created":1790056888182,"text":"回归测试"},"children":[]},{"data":{"id":"dllm7mohmyg0","created":1790056898617,"text":"验收测试"},"children":[]}]},{"data":{"id":"dllm6z7esao0","created":1790056847519,"text":"非功能性测试","expandState":"collapse"},"children":[{"data":{"id":"dllm7sy9vrk0","created":1790056912270,"text":"性能测试","expandState":"collapse"},"children":[{"data":{"id":"dllm7z1wu8w0","created":1790056925550,"text":"负载"},"children":[]},{"data":{"id":"dllm80lq1oo0","created":1790056928925,"text":"压力"},"children":[]},{"data":{"id":"dllm81a8kug0","created":1790056930407,"text":"并发"},"children":[]}]},{"data":{"id":"dllm7u2o5nk0","created":1790056914712,"text":"稳定性测试","expandState":"collapse"},"children":[{"data":{"id":"dllmak78tco0","created":1790057128314,"text":"长时间"},"children":[]},{"data":{"id":"dllmalfzk480","created":1790057131019,"text":"高温高压"},"children":[]},{"data":{"id":"dllmao0wv4w0","created":1790057136638,"text":"高负载"},"children":[]}]},{"data":{"id":"dllm8e8359c0","created":1790056958576,"text":"安全性测试","expandState":"collapse"},"children":[{"data":{"id":"dllmasjdkcw0","created":1790057146461,"text":"漏洞扫描"},"children":[]},{"data":{"id":"dllmavnj4aw0","created":1790057153243,"text":"渗透测试"},"children":[]}]},{"data":{"id":"dllm8ioq4080","created":1790056968289,"text":"兼容性测试","expandState":"collapse"},"children":[{"data":{"id":"dllm8k68inc0","created":1790056971524,"text":"版本"},"children":[]},{"data":{"id":"dllm8p3i31c0","created":1790056982243,"text":"软硬件"},"children":[]},{"data":{"id":"dllm8qabrs00","created":1790056984832,"text":"操作系统"},"children":[]}]},{"data":{"id":"dllm8us7b8g0","created":1790056994620,"text":"容错性测试","expandState":"collapse"},"children":[{"data":{"id":"dllm8x3f3tc0","created":1790056999652,"text":"故障注入"},"children":[]},{"data":{"id":"dllm92fiwdk0","created":1790057011268,"text":"断电断网"},"children":[]},{"data":{"id":"dllm96b1b940","created":1790057019704,"text":"弱网"},"children":[]},{"data":{"id":"dllm99pe6r40","created":1790057027102,"text":"软硬件异常"},"children":[]}]}]}]},{"data":{"id":"dlllzfh8y5k0","created":1790056256029,"text":"测试流程"},"children":[{"data":{"id":"dllmdcrb1xk0","created":1790057347205,"text":"需求分析&定义","expandState":"collapse"},"children":[{"data":{"id":"dllmkljrp0g0","created":1790057914889,"text":"输入","expandState":"collapse"},"children":[{"data":{"id":"dllmkalhobc0","created":1790057891049,"text":"产品需求文档"},"children":[]},{"data":{"id":"dllmkcomhyo0","created":1790057895592,"text":"系统架构"},"children":[]},{"data":{"id":"dllmkfv478g0","created":1790057902515,"text":"通信架构"},"children":[]}]},{"data":{"id":"dllmkr0w4740","created":1790057926809,"text":"可测性分析"},"children":[{"data":{"id":"dllml5eiavc0","created":1790057958107,"text":"需求可量化"},"children":[]},{"data":{"id":"dllmldmpi3k0","created":1790057976017,"text":"准出有标准"},"children":[]}]}]},{"data":{"id":"dllmiq9p36w0","created":1790057768436,"text":"测试计划&方案设计","expandState":"collapse"},"children":[{"data":{"id":"dllmn2zpi000","created":1790058109587,"text":"测试计划","note":"1. 预估测试环境、设备需求\n2. 预估测试周期","expandState":"collapse"},"children":[{"data":{"id":"dllmpfsnink0","created":1790058294187,"text":"预估测试环境、设备需求"},"children":[]},{"data":{"id":"dllmpfsnp5c0","created":1790058294187,"text":"预估测试周期"},"children":[]}]},{"data":{"id":"dllmn45pzj40","created":1790058112127,"text":"测试方案","note":"1.明确测试类型：功能、性能、兼容性等\n2.明确测试验收标准","expandState":"collapse"},"children":[{"data":{"id":"dllmplb865c0","created":1790058306194,"text":"明确测试类型：功能、性能、兼容性等"},"children":[]},{"data":{"id":"dllmplb8ei80","created":1790058306194,"text":"明确测试验收标准"},"children":[]}]}]},{"data":{"id":"dllmiwthl400","created":1790057782693,"text":"测试用例与自动化脚本开发","expandState":"collapse"},"children":[{"data":{"id":"dllmqb9vv000","created":1790058362709,"text":"用例主要内容","expandState":"collapse"},"children":[{"data":{"id":"dllmpwv1wc80","created":1790058331337,"text":"测试依赖"},"children":[]},{"data":{"id":"dllmq2bsw6w0","created":1790058343234,"text":"测试步骤"},"children":[]},{"data":{"id":"dllmq4el7gw0","created":1790058347756,"text":"预期结果"},"children":[]}]},{"data":{"id":"dllmqjji3ds0","created":1790058380705,"text":"测试用例要点","expandState":"collapse"},"children":[{"data":{"id":"dllmqp2o0gw0","created":1790058392747,"text":"可量化"},"children":[]},{"data":{"id":"dllmqqol2uw0","created":1790058396249,"text":"可执行"},"children":[]}]}]},{"data":{"id":"dllmj4f2u3c0","created":1790057799236,"text":"测试策略制定","expandState":"collapse"},"children":[{"data":{"id":"dllmvmnaym80","created":1790058779286,"text":"版本目的是什么"},"children":[]},{"data":{"id":"dllms0z1cog0","created":1790058497013,"text":"需求有什么"},"children":[]},{"data":{"id":"dllms6797eo0","created":1790058508394,"text":"测试方案是什么"},"children":[]},{"data":{"id":"dllmsi6lm480","created":1790058534476,"text":"准出标准是什么"},"children":[]},{"data":{"id":"dllmskd8dp40","created":1790058539231,"text":"测试用例有什么"},"children":[]}]},{"data":{"id":"dllmjlbthkw0","created":1790057836044,"text":"测试执行&bug跟踪","expandState":"collapse"},"children":[{"data":{"id":"dllmr5qatso0","created":1790058429005,"text":"结果点灯"},"children":[]},{"data":{"id":"dllmreqpepc0","created":1790058448620,"text":"问题跟踪"},"children":[]}]},{"data":{"id":"dllmjqd77ow0","created":1790057847012,"text":"版本释放&问题回归","expandState":"collapse"},"children":[{"data":{"id":"dllmrly7mpc0","created":1790058464312,"text":"重点测试问题已修复"},"children":[]},{"data":{"id":"dllmrrw1ofk0","created":1790058477242,"text":"遗留问题组织评审"},"children":[]},{"data":{"id":"dllmwghjwyw0","created":1790058844241,"text":"确认无阻塞后版本发布"},"children":[]}]}]},{"data":{"id":"djlc89nzuq80","created":1782716420674,"text":"缺陷管理流程","expandState":"collapse"},"children":[{"data":{"id":"dllmww91pk00","created":1790058878556,"text":"提单"},"children":[]},{"data":{"id":"dllmwxt0jts0","created":1790058881940,"text":"开发&SE确认"},"children":[]},{"data":{"id":"dllmx1iza140","created":1790058890040,"text":"实施修改"},"children":[]},{"data":{"id":"dllmx3rsnts0","created":1790058894927,"text":"测试回归"},"children":[]},{"data":{"id":"dllmx9tq5zk0","created":1790058908104,"text":"问题关闭"},"children":[]}]},{"data":{"id":"djlc8ds5qd40","created":1782716429633,"text":"测试工具"},"children":[]}]}]}]},{"data":{"id":"dlkpre428bk0","created":1789965350624,"text":"前端开发"},"children":[{"data":{"id":"dlllt9iv9i80","created":1790055772881,"text":"JavaScript、css、html"},"children":[]},{"data":{"id":"dllluauwegg0","created":1790055854150,"text":"vue"},"children":[]},{"data":{"id":"dlllullvfn40","created":1790055877548,"text":"docker"},"children":[]}]},{"data":{"id":"dm07jtm79iw0","created":1791538936788,"text":"具身智能"},"children":[{"data":{"id":"dm07kgrtzwg0","created":1791538987194,"text":"系统稳定性"},"children":[{"data":{"id":"dm0940fv6ew0","created":1791543340036,"text":"1、确定可靠性指标","expandState":"expand"},"children":[{"data":{"id":"dm07om9jv6o0","created":1791539312606,"text":"系统故障","expandState":"collapse"},"children":[{"data":{"id":"dm07tsabd200","created":1791539717534,"text":"cpu"},"children":[]},{"data":{"id":"dm07ttacnj40","created":1791539719713,"text":"内存"},"children":[]},{"data":{"id":"dm07tuqgib40","created":1791539722864,"text":"io"},"children":[]},{"data":{"id":"dm07twf06hs0","created":1791539726525,"text":"gpu"},"children":[]}]},{"data":{"id":"dm07opj682o0","created":1791539319719,"text":"任务状态"},"children":[{"data":{"id":"dm07kocitwg0","created":1791539003683,"text":"平均故障率"},"children":[]},{"data":{"id":"dm07kr11gb40","created":1791539009519,"text":"平均故障时间\\间隔"},"children":[]},{"data":{"id":"dm07sgvo7s00","created":1791539614340,"text":"任务执行时间"},"children":[]},{"data":{"id":"dm07wj9izx40","created":1791539932988,"text":"预期结果指标"},"children":[]},{"data":{"id":"dm07wmahbe00","created":1791539939576,"text":"不产生非预期结果"},"children":[]}]},{"data":{"id":"dm07os209pk0","created":1791539325211,"text":"动作异常"},"children":[{"data":{"id":"dm07sxpgzwg0","created":1791539650970,"text":"速度"},"children":[]},{"data":{"id":"dm07szr2hlk0","created":1791539655420,"text":"力量"},"children":[]},{"data":{"id":"dm07t18xiag0","created":1791539658677,"text":"位姿"},"children":[]}]},{"data":{"id":"dm07yx534so0","created":1791540119923,"text":"异常恢复机制","expandState":"expand"},"children":[{"data":{"id":"dm083gon4m80","created":1791540475921,"text":"硬件故障"},"children":[{"data":{"id":"dm083lugk200","created":1791540487156,"text":"传感器异常"},"children":[]},{"data":{"id":"dm083qxc9fc0","created":1791540498214,"text":"机械臂损伤"},"children":[]}]},{"data":{"id":"dm09ip51okw0","created":1791544490899,"text":"软件异常"},"children":[{"data":{"id":"dm09itbpgr40","created":1791544500009,"text":"coredump"},"children":[]},{"data":{"id":"dm09iv2eers0","created":1791544503800,"text":"oom"},"children":[]},{"data":{"id":"dm09j1yez6w0","created":1791544518796,"text":"进程卡死"},"children":[]}]}]},{"data":{"id":"dm09dasrioo0","created":1791544067861,"text":"系统稳定性"},"children":[{"data":{"id":"dm07uwevtj40","created":1791539804882,"text":"时间驱动"},"children":[{"data":{"id":"dm07uzpwufk0","created":1791539812079,"text":"单任务长时间运行的稳定性"},"children":[]}]},{"data":{"id":"dm07mks92eo0","created":1791539152655,"text":"环境负载驱动"},"children":[{"data":{"id":"dm07lmteo880","created":1791539078715,"text":"固定负载下单活动稳定性"},"children":[]},{"data":{"id":"dm07m5ex9940","created":1791539119198,"text":"耦合负载下的单活动稳定性"},"children":[]}]},{"data":{"id":"dm07mtgteg80","created":1791539171555,"text":"离散任务驱动"},"children":[{"data":{"id":"dm07lmteo880","created":1791539078715,"text":"固定负载下多任务的稳定性"},"children":[]},{"data":{"id":"dm07m5ex9940","created":1791539119198,"text":"耦合负载下多任务的稳定性"},"children":[]}]}]}]},{"data":{"id":"dm0944858e80","created":1791543348276,"text":"2、建立可靠性评测模型"},"children":[{"data":{"id":"dm0800njv1s0","created":1791540205934,"text":"业务场景模型","note":"真实、全面地描述、精准刻画系统执行任务时所处的真实环境"},"children":[{"data":{"id":"dm080hoe8680","created":1791540242990,"text":"头部场景"},"children":[]},{"data":{"id":"dm080mirvyg0","created":1791540253534,"text":"长尾场景"},"children":[{"data":{"id":"dm084m6z96g0","created":1791540566277,"text":"极端场景","expandState":"collapse"},"children":[{"data":{"id":"dm0acjsalao0","created":1791546830169,"text":"温度"},"children":[]},{"data":{"id":"dm0acl9cj9k0","created":1791546833377,"text":"湿度"},"children":[]},{"data":{"id":"dm0acmoaqkg0","created":1791546836458,"text":"震动"},"children":[]},{"data":{"id":"dm0acp59y540","created":1791546841838,"text":"声波"},"children":[]},{"data":{"id":"dm0ad4ay4iw0","created":1791546874833,"text":"静电"},"children":[]}]},{"data":{"id":"dm084p3lq280","created":1791540572604,"text":"边界任务"},"children":[]},{"data":{"id":"dm0882qdgbk0","created":1791540837372,"text":"系统性能边界"},"children":[]}]},{"data":{"id":"dm080oxea3c0","created":1791540258772,"text":"环境耦合"},"children":[]},{"data":{"id":"dm080w0fuw00","created":1791540274193,"text":"异常工况"},"children":[]},{"data":{"id":"dm0814by4vs0","created":1791540292303,"text":"动态参与物"},"children":[]}]},{"data":{"id":"dm08b4w9hfs0","created":1791541077173,"text":"仿真探索性能边界"},"children":[{"data":{"id":"dm08bo4r3vk0","created":1791541119046,"text":"采样生成法","note":"通过概率抽样，尤其利用重要度抽样等技术聚焦低概率高影响区域，从而生成有代表性的极端/边缘场景。该方法能够聚焦关键区域或低概率事件进行采样，快速生成具有代表性的极端/边缘场景"},"children":[{"data":{"id":"dm08prgmdig0","created":1791542223392,"text":"1. 建立基础概率分布模型","note":"通过采集海量的真实路测数据（自然驾驶数据），统计出各个变量的概率分布。\n\n\n• 例如：统计发现，前方前车切入（Cut-in）的距离 (d) 绝大多数集中在 20 米（高概率、低风险的头部区域）；而在 3-5m 米贴脸切入的概率只有0.01%（低概率、高风险的尾部区域）。\n"},"children":[]},{"data":{"id":"dm08qn0waxs0","created":1791542292098,"text":"2、设计“重要性采样”权重函数","note":"如果直接在基础分布里随机抽样（蒙特卡洛采样），可能跑 10 万次仿真也抽不到一次危险场景，算力全浪费在“晴天直行”上了。\n\n• 工程破局：引入 重要性采样（Importance Sampling）。构造一个伪概率分布（变换分布），人为地将危险区域（如 3-5 米切入）的抽样权重放大 1000 倍"},"children":[]},{"data":{"id":"dm08rb4raxs0","created":1791542344574,"text":"3. 执行抽样并转换场景脚本","note":"抽样引擎（通常使用 Python 编写的统计抽样模块）基于调整后的分布，高频抽取出一组组参数：\n• 抽取结果示例：[车速=120km/h, 距离=4米, 地面摩擦力=0.3(结冰)]。\n• 抽出来后，通过场景转换工具，将这些数字转化为 ASAM OpenSCENARIO 格式的场景脚本，自动输入到仿真器（如 CARLA、Isaac Sim）中进行闭环测试"},"children":[]},{"data":{"id":"dm08s5ktgxc0","created":1791542410849,"text":"4. 统计学权重回构","note":"因为我们人为放大了危险场景的概率，测试完后必须通过数学公式（似然比 Likelihood Ratio）把得分乘回一个修正权重。这样既能高频测出 VLM/VLA 模型的漏洞，又能不失公允地算出系统在真实世界里的真实碰撞概率"},"children":[]}]},{"data":{"id":"dm08c0ymnyg0","created":1791541146974,"text":"优化搜索法","note":"是通过构造优化目标(如碰撞概率、最小安全距离等)，采用梯度下降、遗传算法等搜索技术在高维状态空间中寻找系统性能边界，从而生成挑战性场景。该方法可高效探索系统性能极限，定位目标场景"},"children":[{"data":{"id":"dm08cwccpts0","created":1791541215284,"text":"1、构建仿真沙盒将变量参数化"},"children":[]},{"data":{"id":"dm08d53p0dk0","created":1791541234351,"text":"2、构造函数生成最具风险的测试场景"},"children":[]},{"data":{"id":"dm08evj3sgo0","created":1791541370243,"text":"连续的场景通过梯度下降探索边界"},"children":[]},{"data":{"id":"dm08fzyq0sw0","created":1791541458259,"text":"突变的场景通过全遍历组合出性能边界"},"children":[]},{"data":{"id":"dm08heiyw4w0","created":1791541568322,"text":"3、依据风险场景挖掘性能边界"},"children":[{"data":{"id":"dm08evj3sgo0","created":1791541370243,"text":"连续的场景通过梯度下降探索边界"},"children":[]},{"data":{"id":"dm08fzyq0sw0","created":1791541458259,"text":"突变的场景通过全遍历组合出性能边界"},"children":[]}]},{"data":{"id":"dm08gpp3g880","created":1791541514273,"text":"4、挖掘边界场景 组成专项测试集"},"children":[]}]},{"data":{"id":"dm08cc2lj800","created":1791541171158,"text":"生成建模法","note":"基于深度学习技术构建生成模型，学习极端/边缘场景的潜在分布来生成任务场景。通过极端/边缘场景生成，可以增强智能系统对特殊场景的识别和应对能力，显著提高模型的可靠性，避免由于长尾问题或样本稀缺导致的智能系统故障风险\n\n\n\n• 做法：你给生成模型一堆真实世界里车祸、脱卡、视线遮挡的模糊行车记录仪碎片。模型学会了“极端边缘场景”的视觉特征。\n• 结果：模型凭空画出了一段视频：“在一个暴雨如注、路面积水严重反光的夜间，前方突然出现一辆造型奇特、横着装载着超长钢筋且没有尾灯的改装大卡车骤停。” 这种场景是仿真器里本来没有模型、开发人员压根想不到的，但生成模型能直接像素级把它捏出来。"},"children":[]},{"data":{"id":"dm092adntuw0","created":1791543204942,"text":"故障注入"},"children":[{"data":{"id":"dm092gfo7bk0","created":1791543218124,"text":"探索故障传递路径"},"children":[]},{"data":{"id":"dm092lnwzp40","created":1791543229507,"text":"分析故障影响"},"children":[]}]}]}]},{"data":{"id":"dm094auayg00","created":1791543362676,"text":"3、验证评测结果可靠性"},"children":[{"data":{"id":"dm09cmkw99k0","created":1791544015142,"text":"对比验证"},"children":[]},{"data":{"id":"dm09cnxl2g00","created":1791544018086,"text":"交叉验证"},"children":[]},{"data":{"id":"dm09cp9e5r40","created":1791544020977,"text":"回归验证"},"children":[]}]},{"data":{"id":"dm09n68qjow0","created":1791544841584,"text":"难以复现的问题怎么办"},"children":[{"data":{"id":"dm09nkx1mfc0","created":1791544873529,"text":"1、日志定位"},"children":[{"data":{"id":"dm09p2ma58w0","created":1791544990424,"text":"时序问题"},"children":[]},{"data":{"id":"dm09payhxpc0","created":1791545008577,"text":"系统卡顿"},"children":[]}]},{"data":{"id":"dm09ntwib080","created":1791544893088,"text":"2、保存运行环境"},"children":[]},{"data":{"id":"dm09o5q09400","created":1791544918816,"text":"3、记录问题时的数据包"},"children":[]},{"data":{"id":"dm09oapbifs0","created":1791544929658,"text":"4、缩小问题场景"},"children":[]},{"data":{"id":"dm09ogvi1s80","created":1791544943093,"text":"5、加压复现"},"children":[]},{"data":{"id":"dm09pp0lhl40","created":1791545039179,"text":"6、添加日志 "},"children":[]},{"data":{"id":"dm09q8u6yk00","created":1791545082328,"text":"7、每一步测试保留运行记录"},"children":[]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}